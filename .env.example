# ── Entrega dos leads do formulário de avaliação ──────────────────
# Copie para .env (local) ou cadastre como variáveis de ambiente na
# hospedagem. O .env NÃO vai para o Git.

# Chave da Resend — https://resend.com/api-keys
# Sem ela o site continua funcionando, mas o e-mail não é enviado.
ALGEYE_RESEND_API_KEY=

# Quem recebe o lead. Aceita um endereço.
ALGEYE_MAIL_TO=gustavo.henrique@devexsolucoes.com.br

# Remetente. O domínio precisa estar VERIFICADO na Resend (SPF + DKIM),
# senão a API recusa o envio. Enquanto o domínio do AlgEye não existir,
# dá para usar um subdomínio do devexsolucoes.com.br.
ALGEYE_MAIL_FROM=AlgEye <alertas@algeye.com.br>

# ── Opcionais ─────────────────────────────────────────────────────

# Espelho em Slack / n8n / Zapier / CRM. Recebe um POST JSON por lead.
ALGEYE_LEAD_WEBHOOK=

# Onde gravar o arquivo de apoio em desenvolvimento.
ALGEYE_LEAD_FILE=
